{
  "name": "ios-cert-checker",
  "version": "0.1.0",
  "description": "Privacy-first local CLI for inspecting iOS signing certificates and provisioning profiles.",
  "type": "module",
  "bin": {
    "ios-cert-checker": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "ios",
    "certificate",
    "provisioning-profile",
    "mobileprovision",
    "p12",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david-x3d/ios-cert-checker.git"
  },
  "bugs": {
    "url": "https://github.com/david-x3d/ios-cert-checker/issues"
  },
  "homepage": "https://github.com/david-x3d/ios-cert-checker#readme",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "node-forge": "^1.3.1",
    "plist": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/node-forge": "^1.3.11",
    "@types/plist": "^3.0.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.17"
  }
}
